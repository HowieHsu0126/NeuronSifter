{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://neuronsifter.org/schemas/rollout_uncertainty.schema.json",
  "title": "NeuronSifter RolloutUncertainty", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "uncertainty_uid", "rollout_uids", "components", "point_estimate", "interval_or_distribution", "aggregation_policy", "unknown_components", "status"],
  "properties": {
    "schema_version": {"const": "neuronsifter-rollout-uncertainty-v1"}, "uncertainty_uid": {"$ref": "#/$defs/text"}, "rollout_uids": {"$ref": "#/$defs/texts"},
    "components": {"type": "object", "required": ["initial_state_uncertainty", "action_parameter_uncertainty", "model_parameter_uncertainty", "stochastic_rollout_uncertainty", "numerical_uncertainty", "model_family_disagreement", "fidelity_disagreement", "support_domain_extrapolation", "observation_or_calibration_uncertainty"], "additionalProperties": {"type": "object", "minProperties": 1}},
    "point_estimate": {"type": "object", "minProperties": 1}, "interval_or_distribution": {"type": "object", "minProperties": 1},
    "aggregation_policy": {"$ref": "#/$defs/text"}, "unknown_components": {"type": "array", "items": {"type": "string"}}, "status": {"enum": ["reported", "reported_with_unknown_components", "incomplete"]}
  },
  "$defs": {"text": {"type": "string", "minLength": 1}, "texts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}}}
}
