{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neuronsifter.local/schemas/prospective-method-preregistration-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "audit_uid",
    "reviewed_on",
    "method_uid",
    "freeze_fields",
    "reason",
    "training_authorized",
    "gpu_authorized",
    "six_context_outcome_access",
    "protected_holdout_access",
    "authority_binding"
  ],
  "properties": {
    "schema_version": {"const": "neuronsifter-prospective-method-preregistration-v1"},
    "status": {"enum": ["PREREGISTERED", "NOT_ISSUED_TRAINING_DOMAIN_UNQUALIFIED"]},
    "audit_uid": {"type": "string", "minLength": 1},
    "reviewed_on": {"type": "string", "format": "date"},
    "method_uid": {"type": ["string", "null"]},
    "freeze_fields": {"type": "object"},
    "reason": {"type": "string", "minLength": 1},
    "training_authorized": {"type": "boolean"},
    "gpu_authorized": {"type": "boolean"},
    "six_context_outcome_access": {"const": 0},
    "protected_holdout_access": {"const": 0},
    "authority_binding": {"type": "object"}
  }
}
