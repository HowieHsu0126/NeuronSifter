{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neuronsifter.org/schemas/clean_action_complete_trajectory.schema.json",
  "title": "NeuronSifter CleanActionCompleteTrajectory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "trajectory_uid", "trajectory_family_uid", "episode_uid",
    "producer_uid", "producer_version", "producer_type", "initial_state_ref",
    "initial_state_hash", "world_action_ref", "action_program_hash",
    "no_action_control_ref", "support_domain_ref", "state_namespace",
    "region_axis", "compartment_axis", "species_or_feature_axis", "channel_units",
    "start_time", "end_time", "time_unit", "time_grid", "native_solver_time_grid",
    "canonical_export_time_grid", "sampling_interval", "adaptive_step_metadata",
    "interpolation", "state_values_ref", "state_values_hash", "uncertainty_ref",
    "constraint_diagnostics_ref", "numerical_qc_ref", "physical_qc_ref",
    "producer_inputs_hash", "producer_parameters_hash", "random_seed", "code_commit",
    "environment_hash", "runtime_identity", "status", "eligibility", "provenance",
    "derived_from_legacy_trajectory_ref", "promotion_method", "promotion_validation",
    "fidelity_uid", "conflicts"
  ],
  "properties": {
    "schema_version": {"const": "neuronsifter-clean-action-complete-trajectory-v1"},
    "trajectory_uid": {"type": "string", "minLength": 1},
    "trajectory_family_uid": {"type": "string", "minLength": 1},
    "episode_uid": {"type": "string", "minLength": 1},
    "producer_uid": {"type": "string", "minLength": 1},
    "producer_version": {"type": "string", "minLength": 1},
    "producer_type": {"enum": ["mechanistic_ode", "mechanistic_pde", "agent_based_model", "network_dynamics_model", "hybrid_multiscale_simulator", "governed_scientific_tool", "validated_replay_engine"]},
    "initial_state_ref": {"type": "string", "minLength": 1},
    "initial_state_hash": {"$ref": "#/$defs/sha256"},
    "world_action_ref": {"type": "string", "minLength": 1},
    "action_program_hash": {"$ref": "#/$defs/sha256"},
    "no_action_control_ref": {"type": ["string", "null"]},
    "support_domain_ref": {"type": "string", "minLength": 1},
    "state_namespace": {"type": "string", "minLength": 1},
    "region_axis": {"$ref": "#/$defs/nonemptyStrings"},
    "compartment_axis": {"$ref": "#/$defs/nonemptyStrings"},
    "species_or_feature_axis": {"$ref": "#/$defs/nonemptyStrings"},
    "channel_units": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}},
    "start_time": {"type": "number"},
    "end_time": {"type": "number"},
    "time_unit": {"type": "string", "minLength": 1},
    "time_grid": {"$ref": "#/$defs/nonemptyNumbers"},
    "native_solver_time_grid": {"$ref": "#/$defs/nonemptyNumbers"},
    "canonical_export_time_grid": {"$ref": "#/$defs/nonemptyNumbers"},
    "sampling_interval": {"type": "object", "minProperties": 1},
    "adaptive_step_metadata": {"type": "object", "minProperties": 1},
    "interpolation": {"type": "object", "minProperties": 1},
    "state_values_ref": {"type": "string", "minLength": 1},
    "state_values_hash": {"$ref": "#/$defs/sha256"},
    "uncertainty_ref": {"type": "string", "minLength": 1},
    "constraint_diagnostics_ref": {"type": "string", "minLength": 1},
    "numerical_qc_ref": {"type": "string", "minLength": 1},
    "physical_qc_ref": {"type": "string", "minLength": 1},
    "producer_inputs_hash": {"$ref": "#/$defs/sha256"},
    "producer_parameters_hash": {"$ref": "#/$defs/sha256"},
    "random_seed": {"type": "integer", "minimum": 0},
    "code_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "environment_hash": {"$ref": "#/$defs/sha256"},
    "runtime_identity": {"type": "object", "minProperties": 1},
    "status": {"enum": ["generated", "failed", "quarantined"]},
    "eligibility": {"enum": ["qualification_numerical_dynamics_only", "restricted_clean_dynamics", "strong_clean_dynamics", "stress_only", "ineligible"]},
    "provenance": {"type": "object", "minProperties": 1},
    "derived_from_legacy_trajectory_ref": {"type": ["string", "null"]},
    "promotion_method": {"enum": ["new_governed_generation", "governed_regeneration", "not_applicable"]},
    "promotion_validation": {"type": "object", "minProperties": 1},
    "fidelity_uid": {"type": "string", "minLength": 1},
    "conflicts": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "nonemptyStrings": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "nonemptyNumbers": {"type": "array", "minItems": 2, "items": {"type": "number"}}
  }
}
