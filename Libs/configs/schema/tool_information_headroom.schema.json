{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neuronsifter.local/schemas/tool-information-headroom-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "review_uid",
    "reviewed_on",
    "scope_boundary",
    "development_proxy_evidence",
    "ambiguous_contexts",
    "hidden_outcome_denylist",
    "memory_boundary",
    "formal_agent_in_twin_headline_authorized",
    "protected_holdout_access",
    "evidence_bindings"
  ],
  "properties": {
    "schema_version": {"const": "neuronsifter-tool-information-headroom-v1"},
    "status": {"enum": ["TOOL_INFORMATION_HEADROOM_SUPPORTED", "TOOL_INFORMATION_HEADROOM_NOT_SUPPORTED"]},
    "review_uid": {"type": "string", "minLength": 1},
    "reviewed_on": {"type": "string", "format": "date"},
    "scope_boundary": {"type": "string", "minLength": 1},
    "development_proxy_evidence": {"type": "object"},
    "ambiguous_contexts": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "object"}},
    "hidden_outcome_denylist": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "memory_boundary": {"type": "object"},
    "formal_agent_in_twin_headline_authorized": {"type": "boolean"},
    "protected_holdout_access": {"const": 0},
    "evidence_bindings": {"type": "object"}
  }
}
