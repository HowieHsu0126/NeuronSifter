{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neuronsifter.local/schemas/functional-publication-evidence-graph-validation-v1.json",
  "title": "NeuronSifter publication-centered functional evidence graph validation report",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "passed",
    "blocker_count",
    "blockers",
    "source_count",
    "publication_resolved_count",
    "functional_artifact_present_count",
    "machine_readable_candidate_count",
    "admission_eligible_source_count",
    "legal_candidate_set_count",
    "qualified_candidate_set_count",
    "protected_holdout_access"
  ],
  "properties": {
    "schema_version": {"const": "neuronsifter-functional-publication-evidence-graph-validation-v1"},
    "status": {"enum": ["passed", "blocked"]},
    "passed": {"type": "boolean"},
    "blocker_count": {"type": "integer", "minimum": 0},
    "blockers": {"type": "array", "items": {"type": "string"}},
    "source_count": {"type": "integer", "minimum": 0},
    "publication_resolved_count": {"type": "integer", "minimum": 0},
    "functional_artifact_present_count": {"type": "integer", "minimum": 0},
    "machine_readable_candidate_count": {"type": "integer", "minimum": 0},
    "admission_eligible_source_count": {"type": "integer", "minimum": 0},
    "legal_candidate_set_count": {"type": "integer", "minimum": 0},
    "qualified_candidate_set_count": {"type": "integer", "minimum": 0},
    "protected_holdout_access": {"const": 0}
  },
  "additionalProperties": false
}
