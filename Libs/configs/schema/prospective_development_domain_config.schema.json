{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neuronsifter.local/schemas/prospective-development-domain-config-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "audit_uid",
    "reviewed_on",
    "required_roles",
    "independence_dimensions",
    "target_action_modalities",
    "allowed_development_inputs",
    "prohibited_inputs",
    "inputs",
    "stop_policy",
    "outputs"
  ],
  "properties": {
    "schema_version": {"const": "neuronsifter-prospective-development-domain-config-v1"},
    "audit_uid": {"const": "prospective_zero_shot_development_domain_authority"},
    "reviewed_on": {"type": "string", "format": "date"},
    "required_roles": {"type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": {"type": "string"}},
    "independence_dimensions": {"type": "array", "minItems": 5, "uniqueItems": true, "items": {"type": "string"}},
    "target_action_modalities": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string"}},
    "allowed_development_inputs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "prohibited_inputs": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "inputs": {"type": "object", "minProperties": 10},
    "stop_policy": {"type": "object"},
    "outputs": {"type": "object", "minProperties": 6}
  }
}
