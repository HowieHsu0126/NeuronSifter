{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neuronsifter.local/schemas/evidence_pairing_decision.schema.json",
  "title": "NeuronSifter EvidencePairingDecision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "pairing_uid", "source_node_uid", "target_node_uid", "decision", "identity_axis_results", "required_identity_axes", "pairing_evidence", "blockers", "status"],
  "$defs": {"axis_state": {"enum": ["exact_match", "compatible", "different_but_allowed", "different_and_blocking", "unknown", "not_applicable"]}},
  "properties": {
    "schema_version": {"const": "neuronsifter-evidence-pairing-decision-v1"},
    "pairing_uid": {"type": "string", "minLength": 1},
    "source_node_uid": {"type": "string", "minLength": 1},
    "target_node_uid": {"type": "string", "minLength": 1},
    "decision": {"enum": ["valid_longitudinal_pair", "valid_action_endpoint_pair", "valid_cross_sectional_comparison", "valid_simulator_trajectory_pair", "valid_model_output_pair", "semantic_alignment_only", "insufficient_identity", "incompatible_context", "incompatible_time", "incompatible_action", "incompatible_biological_unit", "unsupported_pairing"]},
    "identity_axis_results": {
      "type": "object", "additionalProperties": false,
      "required": ["publication_uid", "accession_uid", "study_uid", "cohort_uid", "biological_unit_uid", "sample_uid", "organism", "disease_state", "tissue", "brain_region", "compartment", "cell_type", "modality", "assay", "action_uid", "target_program_uid", "dose", "route", "schedule", "timepoint", "trajectory_family_uid", "simulator_family_uid", "tool_family_uid"],
      "properties": {
        "publication_uid": {"$ref": "#/$defs/axis_state"}, "accession_uid": {"$ref": "#/$defs/axis_state"}, "study_uid": {"$ref": "#/$defs/axis_state"}, "cohort_uid": {"$ref": "#/$defs/axis_state"}, "biological_unit_uid": {"$ref": "#/$defs/axis_state"}, "sample_uid": {"$ref": "#/$defs/axis_state"}, "organism": {"$ref": "#/$defs/axis_state"}, "disease_state": {"$ref": "#/$defs/axis_state"}, "tissue": {"$ref": "#/$defs/axis_state"}, "brain_region": {"$ref": "#/$defs/axis_state"}, "compartment": {"$ref": "#/$defs/axis_state"}, "cell_type": {"$ref": "#/$defs/axis_state"}, "modality": {"$ref": "#/$defs/axis_state"}, "assay": {"$ref": "#/$defs/axis_state"}, "action_uid": {"$ref": "#/$defs/axis_state"}, "target_program_uid": {"$ref": "#/$defs/axis_state"}, "dose": {"$ref": "#/$defs/axis_state"}, "route": {"$ref": "#/$defs/axis_state"}, "schedule": {"$ref": "#/$defs/axis_state"}, "timepoint": {"$ref": "#/$defs/axis_state"}, "trajectory_family_uid": {"$ref": "#/$defs/axis_state"}, "simulator_family_uid": {"$ref": "#/$defs/axis_state"}, "tool_family_uid": {"$ref": "#/$defs/axis_state"}
      }
    },
    "required_identity_axes": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "pairing_evidence": {"type": "object"},
    "blockers": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "status": {"enum": ["accepted", "rejected", "blocked", "pilot_only"]}
  }
}
