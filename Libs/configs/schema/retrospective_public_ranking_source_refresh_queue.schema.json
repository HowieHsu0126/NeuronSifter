{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neuronsifter.local/schemas/retrospective-public-ranking-source-refresh-queue-v1.json",
  "title": "NeuronSifter append-only metadata-only ranking source refresh queue audit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "status", "queue_path", "queue_digest", "record_count",
    "parent_frozen_queue_path", "parent_frozen_queue_digest", "parent_queue_unchanged",
    "priority_order", "metadata_snapshot_bindings", "preexposed_sources_excluded",
    "abstracts_retrieved_before_priority", "full_text_retrieved_before_priority",
    "figures_retrieved_before_priority", "outcome_values_used_for_priority",
    "observed_effect_used_for_priority", "p_values_used_for_priority",
    "protected_holdout_access", "formal_evidence_admitted", "next_action",
    "records", "created_at"
  ],
  "properties": {
    "schema_version": {"const": "neuronsifter-retrospective-public-ranking-source-refresh-queue-v1"},
    "status": {"const": "metadata_only_refresh_queue_preregistered"},
    "queue_path": {"const": "Input/manifests/retrospective_public/ranking_source_refresh_queue.tsv"},
    "queue_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "record_count": {"type": "integer", "minimum": 1},
    "parent_frozen_queue_path": {"const": "Input/manifests/retrospective_public/ranking_informative_source_queue.tsv"},
    "parent_frozen_queue_digest": {"const": "da26b83d34ee00b417bf7dcb4a75680a05add3a57f75f50b7eef09b9f67c08fd"},
    "parent_queue_unchanged": {"const": true},
    "priority_order": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "metadata_snapshot_bindings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "preexposed_sources_excluded": {"const": true},
    "abstracts_retrieved_before_priority": {"const": false},
    "full_text_retrieved_before_priority": {"const": false},
    "figures_retrieved_before_priority": {"const": false},
    "outcome_values_used_for_priority": {"const": false},
    "observed_effect_used_for_priority": {"const": false},
    "p_values_used_for_priority": {"const": false},
    "protected_holdout_access": {"const": 0},
    "formal_evidence_admitted": {"const": 0},
    "next_action": {"const": "recover_preregistered_public_artifacts_and_qualify_immediately"},
    "records": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "created_at": {"type": "string", "minLength": 1}
  }
}
