{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neuronsifter.local/schema/mechanism_evidence_ledger.schema.json",
  "title": "NeuronSifter mechanism evidence ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "ledger_uid", "contract", "schema", "authorization", "queue", "slots", "request_receipts", "counts", "network_summary", "access_counters", "raw_responses_persisted", "temporary_review_packet_retained", "ledger_sha256", "blockers"],
  "properties": {
    "schema_version": {"const": "neuronsifter-mechanism-evidence-ledger-v1"},
    "status": {"const": "MECHANISM_EVIDENCE_LEDGER_FINALIZED"},
    "ledger_uid": {"const": "mechanism_evidence_ledger"},
    "contract": {"$ref": "#/$defs/fileBinding"},
    "schema": {"$ref": "#/$defs/fileBinding"},
    "authorization": {"$ref": "#/$defs/artifactBinding"},
    "queue": {"$ref": "#/$defs/artifactBinding"},
    "slots": {"type": "array", "minItems": 72, "maxItems": 72, "items": {"$ref": "#/$defs/evidenceRow"}},
    "request_receipts": {"type": "array", "minItems": 15, "maxItems": 45, "items": {"$ref": "#/$defs/contentReceipt"}},
    "counts": {"type": "object", "additionalProperties": false, "required": ["slot_count", "reviewed_eligible_count", "ineligible_count", "grades"], "properties": {"slot_count": {"const": 72}, "reviewed_eligible_count": {"type": "integer", "minimum": 0, "maximum": 15}, "ineligible_count": {"const": 57}, "grades": {"type": "object"}}},
    "network_summary": {"type": "object", "additionalProperties": false, "required": ["request_count", "successful_request_count", "failed_request_count", "total_response_bytes"], "properties": {"request_count": {"type": "integer", "minimum": 0, "maximum": 45}, "successful_request_count": {"type": "integer", "minimum": 0, "maximum": 45}, "failed_request_count": {"type": "integer", "minimum": 0, "maximum": 45}, "total_response_bytes": {"type": "integer", "minimum": 0, "maximum": 134217728}}},
    "access_counters": {"$ref": "#/$defs/accessCounters"},
    "raw_responses_persisted": {"const": false},
    "temporary_review_packet_retained": {"const": false},
    "ledger_sha256": {"$ref": "#/$defs/sha256"},
    "blockers": {"type": "array", "maxItems": 0}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "fileBinding": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string"}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "artifactBinding": {"type": "object", "additionalProperties": false, "required": ["path", "file_sha256", "semantic_sha256"], "properties": {"path": {"type": "string"}, "file_sha256": {"$ref": "#/$defs/sha256"}, "semantic_sha256": {"$ref": "#/$defs/sha256"}}},
    "sectionReceipt": {"type": "object", "additionalProperties": false, "required": ["locator", "section_label", "content_class", "content_sha256"], "properties": {"locator": {"type": "string"}, "section_label": {"type": "string"}, "content_class": {"type": "string"}, "content_sha256": {"$ref": "#/$defs/sha256"}}},
    "contentReceipt": {"type": "object", "additionalProperties": false, "required": ["receipt_uid", "attempt_ordinal", "request_uid", "request_kind", "method", "url", "retrieved_at", "final_host", "content_type", "response_bytes", "response_sha256", "parser_version", "public_access_status", "license_status", "disposition", "allowed_sections", "forbidden_sections_skipped", "mixed_sections_rejected"], "properties": {"receipt_uid": {"type": "string", "pattern": "^mechanism-content-receipt-[0-9a-f]{20}$"}, "attempt_ordinal": {"type": "integer", "minimum": 1, "maximum": 3}, "request_uid": {"type": "string"}, "request_kind": {"const": "pubmed_exact_fetch"}, "method": {"const": "GET"}, "url": {"type": "string"}, "retrieved_at": {"type": "string"}, "final_host": {"type": ["string", "null"]}, "content_type": {"type": ["string", "null"]}, "response_bytes": {"type": "integer", "minimum": 0, "maximum": 16777216}, "response_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}, "parser_version": {"const": "mechanism-content-projector-v1"}, "public_access_status": {"type": "string"}, "license_status": {"type": "string"}, "disposition": {"enum": ["reviewed_allowed_projection", "forbidden_mixed_content", "request_failed", "identifier_mismatch", "forbidden_content_only"]}, "allowed_sections": {"type": "array", "items": {"$ref": "#/$defs/sectionReceipt"}}, "forbidden_sections_skipped": {"type": "integer", "minimum": 0}, "mixed_sections_rejected": {"type": "integer", "minimum": 0}}},
    "semanticClaim": {"type": "object", "additionalProperties": false, "required": ["claim_uid", "claim_type", "paraphrase", "content_locator", "content_sha256", "requirement_uids", "units", "range_context", "assumptions", "limitations", "support_boundary", "contradicts_claim_uids"], "properties": {"claim_uid": {"type": "string", "pattern": "^mechanism-claim-[0-9a-f]{20}$"}, "claim_type": {"enum": ["equation", "causal_dependency", "structural_dependency", "parameter_range", "unit_definition", "assumption", "limitation", "measurement_definition", "latent_to_observable_link", "prior_role_support", "support_boundary"]}, "paraphrase": {"type": "string", "minLength": 1, "maxLength": 600}, "content_locator": {"type": "string", "minLength": 1}, "content_sha256": {"$ref": "#/$defs/sha256"}, "requirement_uids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "units": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "range_context": {"type": ["string", "null"]}, "assumptions": {"type": "array", "items": {"type": "string"}}, "limitations": {"type": "array", "items": {"type": "string"}}, "support_boundary": {"type": ["string", "null"]}, "contradicts_claim_uids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}}},
    "evidenceRow": {"type": "object", "additionalProperties": false, "required": ["queue_order", "slot_uid", "queue_slot_sha256", "canonical_intervention_uid", "validation_uid", "family_uid", "canonical_source_identity", "official_date", "queue_disposition", "projection_sha256", "grade", "grade_rationale", "reviewer_identity", "review_disposition", "content_receipt", "semantic_claims", "claims_supported", "contradiction_status", "units", "assumptions", "limitations", "absence_reason"], "properties": {"queue_order": {"type": "integer", "minimum": 1, "maximum": 72}, "slot_uid": {"type": "string"}, "queue_slot_sha256": {"$ref": "#/$defs/sha256"}, "canonical_intervention_uid": {"type": "string"}, "validation_uid": {"type": "string"}, "family_uid": {"type": "string"}, "canonical_source_identity": {"type": "string"}, "official_date": {"type": ["string", "null"]}, "queue_disposition": {"type": "string"}, "projection_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}, "grade": {"enum": ["DIRECT_MECHANISM", "PARAMETER_ANCHOR", "BOUNDARY_CONSTRAINT", "CONTEXT_ONLY", "INADMISSIBLE"]}, "grade_rationale": {"type": "string", "minLength": 1}, "reviewer_identity": {"type": "string", "minLength": 1}, "review_disposition": {"type": "string", "minLength": 1}, "content_receipt": {"anyOf": [{"$ref": "#/$defs/contentReceipt"}, {"type": "null"}]}, "semantic_claims": {"type": "array", "items": {"$ref": "#/$defs/semanticClaim"}}, "claims_supported": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "contradiction_status": {"enum": ["none_observed", "unresolved", "resolved_by_scope", "not_assessed", "inadmissible"]}, "units": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "assumptions": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "limitations": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "absence_reason": {"type": ["string", "null"]}}},
    "accessCounters": {"type": "object", "additionalProperties": false, "required": ["source_content_access", "successful_source_content_opens", "unqueued_source_attempts", "forbidden_value_reads", "six_context_outcome_access", "protected_holdout_access"], "properties": {"source_content_access": {"type": "integer", "minimum": 0, "maximum": 15}, "successful_source_content_opens": {"type": "integer", "minimum": 0, "maximum": 15}, "unqueued_source_attempts": {"const": 0}, "forbidden_value_reads": {"const": 0}, "six_context_outcome_access": {"const": 0}, "protected_holdout_access": {"const": 0}}}
  }
}
