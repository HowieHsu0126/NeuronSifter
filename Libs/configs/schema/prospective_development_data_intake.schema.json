{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neuronsifter.local/schemas/prospective-development-data-intake-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "status", "intake_uid", "preregistration_digest",
    "parent_state_digest", "repository_family_count", "metadata_asset_cap",
    "metadata_asset_count", "metadata_eligible_count", "queue_lineage_count",
    "metadata_universe_digest", "queue_digest", "metadata_universe_path",
    "queue_path", "metadata_snapshot_binding", "repository_family_status",
    "capability_funnel", "queue_frozen_before_new_development_outcome_access",
    "development_numeric_outcomes_retrieved_before_queue_freeze",
    "six_context_outcome_access", "protected_holdout_access",
    "training_authorized", "gpu_authorized", "next_action", "queue_records",
    "created_at"
  ],
  "properties": {
    "schema_version": {"const": "neuronsifter-prospective-development-data-intake-v1"},
    "status": {"enum": ["development_source_queue_frozen", "development_source_queue_exhausted", "repository_metadata_access_blocked"]},
    "intake_uid": {"const": "prospective_public_cns_action_response_foundation"},
    "preregistration_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "parent_state_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "repository_family_count": {"const": 5},
    "metadata_asset_cap": {"const": 320},
    "metadata_asset_count": {"type": "integer", "minimum": 0, "maximum": 320},
    "metadata_eligible_count": {"type": "integer", "minimum": 0},
    "queue_lineage_count": {"type": "integer", "minimum": 0, "maximum": 16},
    "metadata_universe_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "queue_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "metadata_universe_path": {"type": "string"},
    "queue_path": {"type": "string"},
    "metadata_snapshot_binding": {"type": "object"},
    "repository_family_status": {"type": "array", "minItems": 5, "maxItems": 5},
    "capability_funnel": {"type": "object"},
    "queue_frozen_before_new_development_outcome_access": {"const": true},
    "development_numeric_outcomes_retrieved_before_queue_freeze": {"const": false},
    "six_context_outcome_access": {"const": 0},
    "protected_holdout_access": {"const": 0},
    "training_authorized": {"const": false},
    "gpu_authorized": {"const": false},
    "next_action": {"enum": ["recover_frozen_development_sources", "stop_bounded_intake_exhausted", "retry_same_preregistered_metadata_requests"]},
    "queue_records": {"type": "array", "maxItems": 16},
    "created_at": {"type": "string"}
  }
}
