{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neuronsifter.local/schema/c1_g3_gate.schema.json",
  "title": "NeuronSifter C1 G3 gate result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "gate_id", "status", "corpus_hash", "preflight_hash",
    "capability_manifest_hash", "training_started", "headline_training_started",
    "development_training_status", "empirical_result_status", "completed_run_count",
    "headline_completed_run_count", "failed_run_count", "valid_task_family_count",
    "valid_holdout_family_count", "maximum_reachable_task_family_count",
    "maximum_reachable_holdout_family_count", "minimum_task_family_count",
    "minimum_holdout_family_count", "coverage_reachable", "integrity_blocker_count",
    "blocking_requirement_codes", "claim_allowed", "claim_scope_permission", "reason"
  ],
  "properties": {
    "schema_version": {"const": "neuronsifter-c1-foundation-transfer-gate-v2"},
    "gate_id": {"const": "G3_foundation_transfer_evidence"},
    "status": {"enum": ["passed", "failed_empirical", "failed_statistics", "blocked_incomplete", "not_evaluated"]},
    "corpus_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "preflight_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "capability_manifest_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "training_started": {"type": "boolean"},
    "headline_training_started": {"type": "boolean"},
    "development_training_status": {"enum": ["not_started", "smoke_only", "complete"]},
    "empirical_result_status": {"enum": ["not_evaluated", "smoke_only", "complete"]},
    "completed_run_count": {"type": "integer", "minimum": 0},
    "headline_completed_run_count": {"type": "integer", "minimum": 0},
    "failed_run_count": {"type": "integer", "minimum": 0},
    "valid_task_family_count": {"type": "integer", "minimum": 0},
    "valid_holdout_family_count": {"type": "integer", "minimum": 0},
    "maximum_reachable_task_family_count": {"type": "integer", "minimum": 0},
    "maximum_reachable_holdout_family_count": {"type": "integer", "minimum": 0},
    "minimum_task_family_count": {"const": 2},
    "minimum_holdout_family_count": {"const": 2},
    "coverage_reachable": {"type": "boolean"},
    "integrity_blocker_count": {"type": "integer", "minimum": 0},
    "blocking_requirement_codes": {"type": "array", "items": {"type": "string"}},
    "claim_allowed": {"type": "boolean"},
    "claim_scope_permission": {"enum": ["reduced_core_implementation_and_real_data_smoke_only", "public_data_cns_transcriptomics_foundation_transfer"]},
    "reason": {"type": "string", "minLength": 1}
  }
}
