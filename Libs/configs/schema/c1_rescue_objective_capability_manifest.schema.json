        },
        "single_source_selection": {
          "$ref": "#/$defs/single_source_selection"
        },
        "split_manifest_hash": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "split_manifest_hash",
        "roles",
        "single_source_selection"
      ],
      "type": "object"
    }
  },
