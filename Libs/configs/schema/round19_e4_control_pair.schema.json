{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neuronsifter.local/schemas/round19_e4_control_pair.schema.json",
  "title": "Round19E4ControlPair",
  "type": "object",
  "additionalProperties": false,
  "required": ["pair_uid", "action_trajectory_uid", "control_trajectory_uid", "initial_state_family", "producer_version", "parameter_family", "fidelity", "time_grid", "seed_policy", "pairing_decision", "action_effect_claim_eligible"],
  "properties": {
    "pair_uid": {"type": "string", "minLength": 1},
    "action_trajectory_uid": {"type": "string", "minLength": 1},
    "control_trajectory_uid": {"type": "string", "minLength": 1},
    "initial_state_family": {"type": "string", "minLength": 1},
    "producer_version": {"type": "string", "minLength": 1},
    "parameter_family": {"type": "string", "minLength": 1},
    "fidelity": {"type": "string", "minLength": 1},
    "time_grid": {"type": "string", "minLength": 1},
    "seed_policy": {"type": "string", "minLength": 1},
    "pairing_decision": {"enum": ["exact_deterministic_pair", "matched_stochastic_pair", "group_level_pair", "unpaired_descriptive_rollout"]},
    "action_effect_claim_eligible": {"type": "boolean"}
  }
}
