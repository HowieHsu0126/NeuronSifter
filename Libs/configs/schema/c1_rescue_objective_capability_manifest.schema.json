          "const": "neuronsifter-c1-qualified-semantic-key-v1"
        },
        "status": {
          "const": "not_estimable"
        }
      },
      "required": [
        "status",
        "data_status",
        "semantic_policy_version",
        "eligible_anchor_count",
        "eligible_positive_pair_count",
        "eligible_biological_unit_count",
        "semantic_group_count",
        "represented_source_count",
        "batch_guarantee",
        "blocker"
      ],
      "type": "object"
    },
    "profile_sampler_structural_feasibility": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "structurally_feasible"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "action_plan_fit": {
                "const": true
              },
              "alignment_plan_fit": {
                "const": true
              },
              "blocker": {
                "const": "runtime_replay_required"
              },
              "nuisance_scope_fit": {
                "const": true
              },
              "plan_fit": {
                "const": true
              },
              "replay_required": {
                "const": true
              },
              "runtime_postcondition_required": {
                "const": true
              },
              "within_unit_aggregation_fit": {
                "const": true
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "not_structurally_feasible"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "plan_fit": {
                "const": false
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "not_applicable"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "plan_fit": {
                "const": false
              }
            }
          }
        }
      ],
      "properties": {
        "action_plan_fit": {
          "type": "boolean"
        },
        "action_required": {
          "type": "boolean"
        },
        "alignment_plan_fit": {
          "type": "boolean"
        },
        "alignment_required": {
          "type": "boolean"
        },
        "blocker": {
          "minLength": 1,
          "type": "string"
        },
        "family_balance_plan_status": {
          "enum": [
            "plan_fit",
            "not_fit",
            "disabled_by_declared_ablation",
            "not_applicable",
            "not_applicable_single_family"
          ]
        },
        "nuisance_scope_fit": {
          "type": "boolean"
        },
        "nuisance_scope_required": {
          "type": "boolean"
        },
        "plan_fit": {
          "type": "boolean"
        },
        "replay_required": {
          "type": "boolean"
        },
        "represented_family_count": {
          "minimum": 0,
          "type": "integer"
        },
        "represented_source_count": {
          "minimum": 0,
          "type": "integer"
        },
        "required_biological_unit_count": {
          "minimum": 0,
          "type": "integer"
        },
        "required_observation_count": {
          "minimum": 0,
          "type": "integer"
        },
        "runtime_postcondition_required": {
          "type": "boolean"
        },
        "sampler_profile_contract_hash": {
          "$ref": "#/$defs/sha256"
        },
        "scope_unit_hash": {
          "$ref": "#/$defs/sha256"
        },
        "source_scope": {
          "minLength": 1,
          "type": "string"
        },
        "status": {
          "enum": [
            "structurally_feasible",
            "not_structurally_feasible",
            "not_applicable"
          ]
        },
        "unit_count": {
          "minimum": 0,
          "type": "integer"
        },
        "within_unit_aggregation_fit": {
          "type": "boolean"
        }
      },
      "required": [
        "status",
        "plan_fit",
        "blocker",
        "sampler_profile_contract_hash",
        "source_scope",
        "scope_unit_hash",
        "unit_count",
        "represented_source_count",
        "represented_family_count",
        "alignment_required",
        "alignment_plan_fit",
        "action_required",
        "action_plan_fit",
        "nuisance_scope_required",
        "nuisance_scope_fit",
        "family_balance_plan_status",
        "within_unit_aggregation_fit",
        "replay_required",
        "runtime_postcondition_required",
        "required_biological_unit_count",
        "required_observation_count"
      ],
      "type": "object"
    },
    "profile_sampler_structural_feasibility_map": {
      "additionalProperties": false,
      "properties": {
        "from_scratch_supervised_encoder": {
          "$ref": "#/$defs/profile_sampler_structural_feasibility"
        },
        "generic_masked_encoder": {
          "$ref": "#/$defs/profile_sampler_structural_feasibility"
        },
        "neuronsifter_foundation_state_encoder": {
          "$ref": "#/$defs/profile_sampler_structural_feasibility"
        },
        "no_biological_unit_aggregation": {
          "$ref": "#/$defs/profile_sampler_structural_feasibility"
        },
        "no_ontology_alignment": {
          "$ref": "#/$defs/profile_sampler_structural_feasibility"
        },
        "no_source_family_balancing": {
          "$ref": "#/$defs/profile_sampler_structural_feasibility"
        },
        "no_source_nuisance_control": {
          "$ref": "#/$defs/profile_sampler_structural_feasibility"
        },
        "single_family_pretraining": {
          "$ref": "#/$defs/profile_sampler_structural_feasibility"
        },
        "single_source_pretraining": {
          "$ref": "#/$defs/profile_sampler_structural_feasibility"
        }
      },
      "required": [
        "from_scratch_supervised_encoder",
        "single_source_pretraining",
        "single_family_pretraining",
        "no_ontology_alignment",
        "no_source_family_balancing",
        "generic_masked_encoder",
        "no_source_nuisance_control",
        "no_biological_unit_aggregation",
        "neuronsifter_foundation_state_encoder"
      ],
      "type": "object"
    },
    "role_scopes": {
      "additionalProperties": false,
      "properties": {
        "all_sources": {
          "$ref": "#/$defs/scope"
        },
        "families": {
          "additionalProperties": {
            "$ref": "#/$defs/scope"
          },
          "type": "object"
        },
        "sources": {
          "additionalProperties": {
            "$ref": "#/$defs/scope"
          },
