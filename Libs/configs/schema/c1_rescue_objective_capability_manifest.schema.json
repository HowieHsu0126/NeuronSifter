{
  "$defs": {
    "action_capability": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "representation_identifiability_status": {
                "const": "structurally_identifiable"
              }
            },
            "required": [
              "representation_identifiability_status"
            ]
          },
          "then": {
            "anyOf": [
              {
                "properties": {
                  "distinct_physical_exposure_vector_count": {
                    "minimum": 2
                  }
                }
              },
              {
                "properties": {
                  "within_source_family_non_action_contrast_available": {
                    "const": true
                  }
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "representation_identifiability_status": {
                "const": "not_structurally_identifiable"
              }
            },
            "required": [
              "representation_identifiability_status"
            ]
          },
          "then": {
            "properties": {
              "distinct_physical_exposure_vector_count": {
                "maximum": 1
              },
              "within_source_family_non_action_contrast_available": {
                "const": false
              }
            }
          }
        }
      ],
      "properties": {
        "action_row_runtime_path": {
          "enum": [
            "available",
            "not_available"
          ]
        },
        "batch_guarantee": {
          "const": false
        },
        "blocker": {
          "minLength": 1,
          "type": "string"
        },
        "data_status": {
          "enum": [
            "available",
            "not_available"
          ]
        },
        "distinct_physical_exposure_vector_count": {
          "minimum": 0,
          "type": "integer"
        },
        "distinct_qualified_action_uid_count": {
          "minimum": 0,
          "type": "integer"
        },
        "eligible_biological_unit_count": {
          "minimum": 0,
          "type": "integer"
        },
        "eligible_observation_count": {
          "minimum": 0,
          "type": "integer"
        },
        "representation_identifiability_status": {
          "enum": [
            "structurally_identifiable",
            "not_structurally_identifiable"
          ]
        },
        "represented_source_count": {
          "minimum": 0,
          "type": "integer"
        },
        "status": {
          "const": "not_estimable"
        },
        "within_source_family_non_action_contrast_available": {
          "type": "boolean"
        }
      },
      "required": [
        "status",
        "data_status",
        "action_row_runtime_path",
        "representation_identifiability_status",
        "eligible_observation_count",
        "eligible_biological_unit_count",
        "distinct_qualified_action_uid_count",
        "distinct_physical_exposure_vector_count",
        "within_source_family_non_action_contrast_available",
        "represented_source_count",
        "batch_guarantee",
        "blocker"
      ],
      "type": "object"
    },
    "alignment_capability": {
      "additionalProperties": false,
      "properties": {
        "batch_guarantee": {
          "const": false
        },
        "blocker": {
          "minLength": 1,
          "type": "string"
        },
        "data_status": {
          "enum": [
            "available",
            "not_available"
          ]
        },
        "eligible_anchor_count": {
          "minimum": 0,
          "type": "integer"
        },
        "eligible_biological_unit_count": {
          "minimum": 0,
          "type": "integer"
        },
        "eligible_positive_pair_count": {
