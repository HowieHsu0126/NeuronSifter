{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neuronsifter.org/schemas/trajectory_producer_qualification.schema.json",
  "title": "NeuronSifter TrajectoryProducerQualification",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "qualification_uid", "producer_uid", "producer_version", "support_domain_ref", "action_classes", "checks", "restrictions", "status", "blockers", "provenance"],
  "properties": {
    "schema_version": {"const": "neuronsifter-trajectory-producer-qualification-v1"},
    "qualification_uid": {"type": "string", "minLength": 1},
    "producer_uid": {"type": "string", "minLength": 1},
    "producer_version": {"type": "string", "minLength": 1},
    "support_domain_ref": {"type": "string", "minLength": 1},
    "action_classes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "checks": {"type": "object", "minProperties": 1, "additionalProperties": {"enum": ["passed", "passed_with_restrictions", "not_applicable", "failed"]}},
    "restrictions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "status": {"enum": ["qualified", "qualified_with_restrictions", "blocked_numerical_stability", "blocked_action_semantics", "blocked_initial_state", "blocked_parameter_provenance", "blocked_support_domain", "blocked_environment", "blocked_license"]},
    "blockers": {"type": "array", "items": {"type": "object"}},
    "provenance": {"type": "object", "minProperties": 1}
  }
}
