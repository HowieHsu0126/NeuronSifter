    "sampler_profile": {
      "additionalProperties": false,
      "properties": {
        "active_objectives": {
          "items": {
            "type": "string"
          },
          "type": "array",
          "uniqueItems": true
        },
        "baseline_id": {
          "minLength": 1,
          "type": "string"
        },
        "batch_size": {
          "const": 6
        },
        "family_balance_requirement": {
          "enum": [
            "required",
            "disabled_by_declared_ablation",
            "not_applicable_no_pretraining",
            "not_applicable_single_family"
          ]
        },
        "max_observations_per_biological_unit": {
          "const": 8
        },
        "objective_set": {
          "enum": [
            "none",
            "masked_only",
            "alignment",
            "within_source",
            "full_without_ontology_alignment",
            "full_without_nuisance_control",
            "full_without_biological_unit_aggregation",
            "full"
          ]
        },
        "observation_reservation_policy": {
          "const": "objective_required_rows_before_hash_ranked_fill"
        },
        "pretraining_scope": {
          "enum": [
            "none",
            "one_train_source_per_run",
            "one_train_family_per_run",
            "all_train_sources"
          ]
        },
        "row_sampling_interpretation": {
          "enum": [
            "not_applicable",
            "objective_required_unit_reservation_then_row_proportional_fill_not_unbiased_raw_rows"
          ]
        },
        "runtime_postcondition_policy": {
          "const": "fail_closed_before_batch_return"
        },
        "sampler_contract_version": {
          "const": "neuronsifter-c1-objective-aware-unit-sampler-v1"
        },
        "sampler_mode": {
          "enum": [
            "not_applicable",
            "family_balanced_plain",
            "family_balanced_objective_aware",
            "family_and_biological_unit_balanced_plain",
            "family_and_biological_unit_balanced_objective_aware",
            "biological_unit_balanced_plain",
            "objective_constrained_row_proportional_fill"
          ]
        },
        "sampler_profile_contract_hash": {
          "$ref": "#/$defs/sha256"
        },
        "sampling_policy": {
          "enum": [
            "family_balanced",
            "family_and_biological_unit_balanced",
            "biological_unit_balanced",
            "row_balanced",
            "objective_constrained_row_proportional_fill"
          ]
        },
        "source_scope_policy": {
          "enum": [
            "no_pretraining_scope",
            "train_role_action_units_desc_then_source_id_asc_v1",
            "all_train_sources",
            "all_sources_within_selected_family"
          ]
        },
        "weighting_policy": {
          "enum": [
            "biological_unit_balanced",
            "observation_balanced_within_family",
            "observation_row_balanced",
            "objective_constrained_row_proportional_weighting"
          ]
        },
        "within_unit_aggregation": {
          "const": "required_before_loss"
        }
      },
      "required": [
        "baseline_id",
        "sampler_contract_version",
        "sampler_mode",
        "pretraining_scope",
        "source_scope_policy",
        "objective_set",
        "active_objectives",
        "sampling_policy",
        "weighting_policy",
        "row_sampling_interpretation",
        "family_balance_requirement",
        "batch_size",
        "max_observations_per_biological_unit",
        "within_unit_aggregation",
        "observation_reservation_policy",
        "runtime_postcondition_policy",
        "sampler_profile_contract_hash"
