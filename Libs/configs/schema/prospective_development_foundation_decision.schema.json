    "adjudication_uid": {"type": "string"},
    "reviewed_on": {"type": "string"},
    "scope_boundary": {"type": "string"},
    "interpretation_limitations": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "failure_decomposition": {"type": "object"},
    "work_package_status": {"type": "object"},
    "next_action": {"type": "string"},
    "execution_authority": {"type": "object"},
    "artifact_bindings": {"type": "object"}
  }
}
