{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neuronsifter.org/schemas/twin_debt.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "debt_uid", "belief_state_ref", "component_values", "component_status", "measurement_basis", "unknown_components", "versioned_thresholds", "allowed_decisions", "aggregation", "provenance"],
  "properties": {
    "schema_version": {"const": "neuronsifter-twin-debt-v1"}, "debt_uid": {"$ref": "#/$defs/text"}, "belief_state_ref": {"$ref": "#/$defs/text"},
    "component_values": {"type": "object", "additionalProperties": false, "required": ["calibration_debt", "coverage_debt", "disagreement_debt", "provenance_debt", "constraint_debt"], "properties": {"calibration_debt": {"$ref": "#/$defs/value"}, "coverage_debt": {"$ref": "#/$defs/value"}, "disagreement_debt": {"$ref": "#/$defs/value"}, "provenance_debt": {"$ref": "#/$defs/value"}, "constraint_debt": {"$ref": "#/$defs/value"}}},
    "component_status": {"type": "object", "additionalProperties": false, "required": ["calibration_debt", "coverage_debt", "disagreement_debt", "provenance_debt", "constraint_debt"], "properties": {"calibration_debt": {"$ref": "#/$defs/status"}, "coverage_debt": {"$ref": "#/$defs/status"}, "disagreement_debt": {"$ref": "#/$defs/status"}, "provenance_debt": {"$ref": "#/$defs/status"}, "constraint_debt": {"$ref": "#/$defs/status"}}},
    "measurement_basis": {"type": "object", "minProperties": 1}, "unknown_components": {"$ref": "#/$defs/texts"}, "versioned_thresholds": {"type": "object", "minProperties": 1}, "allowed_decisions": {"$ref": "#/$defs/nonempty_texts"}, "aggregation": {"anyOf": [{"type": "object", "minProperties": 1}, {"type": "null"}]}, "provenance": {"type": "object", "minProperties": 1}
  },
  "$defs": {"text": {"type": "string", "minLength": 1}, "texts": {"type": "array", "items": {"$ref": "#/$defs/text"}, "uniqueItems": true}, "nonempty_texts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}, "uniqueItems": true}, "value": {"anyOf": [{"type": "number", "minimum": 0}, {"type": "null"}]}, "status": {"enum": ["low", "moderate", "high", "unknown"]}}
}
