{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neuronsifter.local/schemas/zero-shot-method-authority-validation-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "passed",
    "blocker_count",
    "blockers",
    "method_authority_status",
    "protocol_status",
    "terminal_blocker",
    "candidate_count",
    "eligible_candidate_count",
    "downstream_work_executed",
    "six_context_outcome_access",
    "execution_authorized",
    "protected_holdout_access",
    "recompute",
    "validation_host",
    "slurm_job_id",
    "validation_scope"
  ],
  "properties": {
    "schema_version": {"const": "neuronsifter-zero-shot-method-authority-validation-v1"},
    "status": {"enum": ["passed", "blocked"]},
    "passed": {"type": "boolean"},
    "blocker_count": {"type": "integer", "minimum": 0},
    "blockers": {"type": "array", "items": {"type": "string"}},
    "method_authority_status": {"type": ["string", "null"]},
    "protocol_status": {"type": ["string", "null"]},
    "terminal_blocker": {"type": ["string", "null"]},
    "candidate_count": {"type": "integer", "minimum": 0},
    "eligible_candidate_count": {"type": "integer", "minimum": 0},
    "downstream_work_executed": {"type": "boolean"},
    "six_context_outcome_access": {"type": ["integer", "null"]},
    "execution_authorized": {"type": ["boolean", "null"]},
    "protected_holdout_access": {"type": ["integer", "null"]},
    "recompute": {"type": "boolean"},
    "validation_host": {"type": "string", "minLength": 1},
    "slurm_job_id": {"type": ["string", "null"]},
    "validation_scope": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
