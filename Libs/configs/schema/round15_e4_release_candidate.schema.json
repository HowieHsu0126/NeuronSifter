{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neuronsifter.org/schemas/round15_e4_release_candidate.schema.json",
  "title": "NeuronSifter Round15 E4 Release Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "release_uid", "release_version", "parent_release_uid", "parent_release_manifest_hash", "created_at", "code_commit", "config_hash", "schema_registry_hash", "input_bundle_hash", "environment_hash", "producer_qualification_hash", "trajectory_catalog_hash", "pairing_catalog_hash", "admission_ledger_hash", "failure_ledger_hash", "gap_map_hash", "independence_group_hash", "trajectory_count", "admission_summary", "allowed_roles", "status", "sealed", "content_hash"],
  "properties": {
    "schema_version": {"const": "neuronsifter-round15-e4-release-candidate-v1"},
    "release_uid": {"type": "string", "minLength": 1},
    "release_version": {"const": "evidence_fabric_v0_round15_e4_successor"},
    "parent_release_uid": {"type": "string", "minLength": 1},
    "parent_release_manifest_hash": {"$ref": "#/$defs/sha256"},
    "created_at": {"type": "string", "minLength": 1},
    "code_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "config_hash": {"$ref": "#/$defs/sha256"},
    "schema_registry_hash": {"$ref": "#/$defs/sha256"},
    "input_bundle_hash": {"$ref": "#/$defs/sha256"},
    "environment_hash": {"$ref": "#/$defs/sha256"},
    "producer_qualification_hash": {"$ref": "#/$defs/sha256"},
    "trajectory_catalog_hash": {"$ref": "#/$defs/sha256"},
    "pairing_catalog_hash": {"$ref": "#/$defs/sha256"},
    "admission_ledger_hash": {"$ref": "#/$defs/sha256"},
    "failure_ledger_hash": {"$ref": "#/$defs/sha256"},
    "gap_map_hash": {"$ref": "#/$defs/sha256"},
    "independence_group_hash": {"$ref": "#/$defs/sha256"},
    "trajectory_count": {"type": "integer", "minimum": 1},
    "admission_summary": {"type": "object", "minProperties": 1},
    "allowed_roles": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "status": {"const": "materialized_unsealed_successor_candidate"},
    "sealed": {"const": false},
    "content_hash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
