        "scope_unit_hash"
      ],
      "type": "object"
    },
    "single_source_selection": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "selection_status": {
                "const": "selected"
              }
            },
            "required": [
              "selection_status"
            ]
          },
          "then": {
            "properties": {
              "blocker": {
                "const": "none"
              },
              "candidates": {
                "minItems": 1
              },
              "selected_source": {
                "minLength": 1,
                "type": "string"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "selection_status": {
                "const": "not_estimable"
              }
            },
            "required": [
              "selection_status"
            ]
          },
          "then": {
            "properties": {
              "blocker": {
                "const": "no_structurally_feasible_identifiable_action_source"
              },
              "candidates": {
                "maxItems": 0
              },
              "selected_source": {
                "const": null
              }
            }
          }
        }
      ],
      "properties": {
        "blocker": {
          "minLength": 1,
          "type": "string"
        },
        "candidate_eligibility": {
          "const": "single_source_profile_structurally_feasible_with_identifiable_action"
        },
        "candidates": {
          "items": {
            "$ref": "#/$defs/single_source_candidate"
          },
          "type": "array"
        },
        "manual_source_argument_policy": {
          "const": "assertion_only"
        },
        "policy": {
          "const": "train_role_action_units_desc_then_source_id_asc_v1"
        },
        "selected_source": {
          "type": [
            "string",
            "null"
          ]
        },
        "selection_status": {
          "enum": [
            "selected",
            "not_estimable"
          ]
        }
      },
      "required": [
        "policy",
        "candidate_eligibility",
        "manual_source_argument_policy",
        "selection_status",
        "candidates",
        "selected_source",
        "blocker"
      ],
      "type": "object"
    },
    "split": {
      "additionalProperties": false,
      "properties": {
        "roles": {
          "additionalProperties": false,
          "properties": {
            "test": {
