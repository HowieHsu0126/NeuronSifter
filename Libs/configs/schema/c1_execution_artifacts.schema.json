{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neuronsifter.local/schema/c1_execution_artifacts.schema.json",
  "title": "NeuronSifter C1 execution artifacts",
  "type": "object",
  "required": [
    "schema_version", "status", "submission_status", "corpus_hash", "capability_manifest_hash",
    "preflight_hash", "split_hashes", "seed_list", "resource_profiles", "headline_model_scale",
    "headline_feasibility", "jobs", "matrix_hash"
  ],
  "properties": {
    "schema_version": {"const": "neuronsifter-c1-job-matrix-v2"},
    "status": {"const": "frozen"},
    "submission_status": {"enum": ["allowed", "blocked_incomplete"]},
    "corpus_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "capability_manifest_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "preflight_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "split_hashes": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "seed_list": {"const": [3407, 3408, 3409, 3410, 3411]},
    "resource_profiles": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "headline_model_scale": {"const": "Large"},
    "headline_feasibility": {"type": "object"},
    "jobs": {"type": "array", "items": {"$ref": "#/$defs/job"}},
    "matrix_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "job": {
      "type": "object",
      "required": [
        "run_uid", "baseline_code", "baseline_id", "runtime_profile_id", "baseline_variant",
        "model_scale", "split_uid", "split_hash", "seed", "job_name", "resource_profile",
        "run_stage", "status", "structural_status", "training_allowed", "submission_allowed",
        "blocker_codes", "corpus_hash", "capability_manifest_hash"
      ],
      "properties": {
        "run_uid": {"type": "string", "minLength": 1},
        "baseline_code": {"pattern": "^B[0-8]$"},
        "baseline_id": {"type": "string", "minLength": 1},
        "runtime_profile_id": {"type": "string", "minLength": 1},
        "baseline_variant": {"type": "string"},
        "model_scale": {"enum": ["Debug", "Student", "Large", "XL"]},
        "split_uid": {"type": "string", "minLength": 1},
        "split_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "seed": {"type": "integer", "minimum": 0},
        "job_name": {"type": "string", "pattern": "^NrnSift_C1_", "maxLength": 96},
        "resource_profile": {"type": "string", "minLength": 1},
        "run_stage": {"const": "pretraining"},
        "status": {"enum": ["planned", "blocked_preflight", "blocked_gate", "blocked_implementation", "not_applicable", "submitted", "running", "passed", "failed", "cancelled"]},
        "structural_status": {"enum": ["structurally_feasible", "not_structurally_feasible", "not_applicable", "unavailable"]},
        "training_allowed": {"type": "boolean"},
        "submission_allowed": {"type": "boolean"},
        "blocker_codes": {"type": "array", "items": {"type": "string"}},
        "source_id": {"type": "string"},
        "family_uid": {"type": "string"},
        "task_family_ids": {"type": "array", "items": {"type": "string"}},
        "holdout_family": {"type": "string"},
        "capability_manifest_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "capability_scope": {"type": "string"},
        "capability_blocker": {"type": "string"},
        "corpus_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
