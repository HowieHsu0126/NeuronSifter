{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neuronsifter.local/schemas/zero-shot-protocol-executability-decision-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "terminal_blocker",
    "review_uid",
    "reviewed_on",
    "work_package_status",
    "scientific_interpretation",
    "minimum_legal_future_route",
    "prohibited_actions",
    "execution_authority",
    "artifact_bindings"
  ],
  "properties": {
    "schema_version": {"const": "neuronsifter-zero-shot-protocol-executability-decision-v1"},
    "status": {"enum": ["PROTOCOL_READY_FOR_ZERO_SHOT_EXECUTION", "ZERO_SHOT_PROTOCOL_REMAINS_NON_EXECUTABLE"]},
    "terminal_blocker": {"type": ["string", "null"]},
    "review_uid": {"type": "string", "minLength": 1},
    "reviewed_on": {"type": "string", "format": "date"},
    "work_package_status": {"type": "object"},
    "scientific_interpretation": {"type": "string", "minLength": 1},
    "minimum_legal_future_route": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "prohibited_actions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "execution_authority": {"type": "object"},
    "artifact_bindings": {"type": "object"}
  }
}
