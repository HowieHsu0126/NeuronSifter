{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neuronsifter.local/schemas/retrospective-public-source-data-first-intake-v1.json",
  "title": "NeuronSifter source-data-first public evidence intake audit",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "status", "intake_uid", "preregistration_digest",
    "parent_state_digest", "repository_family_count", "metadata_asset_cap",
    "metadata_asset_count", "metadata_eligible_count", "queue_record_count",
    "metadata_universe_digest", "metadata_universe_digest_contract",
    "queue_digest", "queue_digest_contract", "metadata_universe_path",
    "queue_path", "metadata_snapshot_binding", "repository_family_status",
    "funnel", "historical_lineage_unchanged", "source_asset_content_retrieved_before_queue_freeze",
    "numeric_outcomes_retrieved_before_queue_freeze", "effect_direction_used_for_priority",
    "p_values_used_for_priority", "winner_statements_used_for_priority",
    "protected_holdout_access", "formal_evidence_admitted", "next_action",
    "queue_records", "created_at"
  ],
  "properties": {
    "schema_version": {"const": "neuronsifter-retrospective-public-source-data-first-intake-v1"},
    "status": {"enum": ["source_data_queue_frozen", "source_data_queue_exhausted", "repository_metadata_access_blocked"]},
    "intake_uid": {"const": "public_source_data_first_cns_ranking_recovery"},
    "preregistration_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "parent_state_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "repository_family_count": {"const": 4},
    "metadata_asset_cap": {"const": 160},
    "metadata_asset_count": {"type": "integer", "minimum": 0, "maximum": 160},
    "metadata_eligible_count": {"type": "integer", "minimum": 0},
    "queue_record_count": {"type": "integer", "minimum": 0, "maximum": 8},
    "metadata_universe_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "metadata_universe_digest_contract": {"const": "source_data_universe_envelope_v1"},
    "queue_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "queue_digest_contract": {"const": "source_data_queue_envelope_v1"},
    "metadata_universe_path": {"type": "string", "minLength": 1},
    "queue_path": {"type": "string", "minLength": 1},
    "metadata_snapshot_binding": {"type": "object"},
    "repository_family_status": {"type": "array", "minItems": 4, "maxItems": 4},
    "funnel": {"type": "object"},
    "historical_lineage_unchanged": {"const": true},
    "source_asset_content_retrieved_before_queue_freeze": {"const": false},
    "numeric_outcomes_retrieved_before_queue_freeze": {"const": false},
    "effect_direction_used_for_priority": {"const": false},
    "p_values_used_for_priority": {"const": false},
    "winner_statements_used_for_priority": {"const": false},
    "protected_holdout_access": {"const": 0},
    "formal_evidence_admitted": {"const": 0},
    "next_action": {"enum": ["recover_source_data_assets_in_priority_order", "stop_source_data_first_queue_exhausted", "retry_same_preregistered_repository_metadata_requests"]},
    "queue_records": {"type": "array", "maxItems": 8},
    "created_at": {"type": "string", "minLength": 1}
  }
}
