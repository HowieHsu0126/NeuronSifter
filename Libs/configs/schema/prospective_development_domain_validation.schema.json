{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neuronsifter.local/schemas/prospective-development-domain-validation-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "passed",
    "blocker_count",
    "blockers",
    "development_domain_status",
    "reconstruction_status",
    "terminal_blocker",
    "four_role_partition_possible",
    "downstream_work_executed",
    "six_context_outcome_access",
    "training_authorized",
    "gpu_authorized",
    "protected_holdout_access",
    "recompute",
    "validation_host",
    "slurm_job_id",
    "validation_scope",
    "implementation_bindings"
  ],
  "properties": {
    "schema_version": {"const": "neuronsifter-prospective-development-domain-validation-v1"},
    "status": {"enum": ["passed", "blocked"]},
    "passed": {"type": "boolean"},
    "blocker_count": {"type": "integer", "minimum": 0},
    "blockers": {"type": "array", "items": {"type": "string"}},
    "development_domain_status": {"type": ["string", "null"]},
    "reconstruction_status": {"type": ["string", "null"]},
    "terminal_blocker": {"type": ["string", "null"]},
    "four_role_partition_possible": {"type": ["boolean", "null"]},
    "downstream_work_executed": {"type": "boolean"},
    "six_context_outcome_access": {"type": ["integer", "null"]},
    "training_authorized": {"type": ["boolean", "null"]},
    "gpu_authorized": {"type": ["boolean", "null"]},
    "protected_holdout_access": {"type": ["integer", "null"]},
    "recompute": {"type": "boolean"},
    "validation_host": {"type": "string", "minLength": 1},
    "slurm_job_id": {"type": ["string", "null"]},
    "validation_scope": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "implementation_bindings": {"type": "object", "minProperties": 3}
  }
}
