{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neuronsifter.org/schemas/benchmark_label.schema.json",
  "title": "NeuronSifter Round-18 typed benchmark label",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "label_uid",
    "episode_uid",
    "target_uid",
    "target_type",
    "label_class",
    "label_value",
    "measurement",
    "unit",
    "direction_semantics",
    "timepoint_or_horizon",
    "comparator",
    "uncertainty",
    "source_refs",
    "label_extraction_method",
    "numeric_reconstruction_from_narrative",
    "adjudication_status",
    "content_hash",
    "status"
  ],
  "properties": {
    "schema_version": {"const": "neuronsifter-benchmark-label-v1"},
    "label_uid": {"$ref": "#/$defs/text"},
    "episode_uid": {"$ref": "#/$defs/text"},
    "target_uid": {"$ref": "#/$defs/text"},
    "target_type": {"$ref": "#/$defs/target_type"},
    "label_class": {"enum": ["data_derived_label", "author_claim_label", "cross_study_consensus_label"]},
    "label_value": {"$ref": "#/$defs/label_value"},
    "measurement": {"$ref": "#/$defs/text"},
    "unit": {"type": ["string", "null"]},
    "direction_semantics": {"$ref": "#/$defs/text"},
    "timepoint_or_horizon": {"$ref": "#/$defs/text"},
    "comparator": {"$ref": "#/$defs/text"},
    "uncertainty": {"$ref": "#/$defs/uncertainty"},
    "source_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
    "source": {"$ref": "#/$defs/source"},
    "label_extraction_method": {"$ref": "#/$defs/text"},
    "numeric_reconstruction_from_narrative": {"const": false},
    "adjudication_status": {"enum": ["pending", "single_adjudicator", "dual_adjudicated", "blocked"]},
    "numerical_support_ref": {"type": ["string", "null"]},
    "strength": {"enum": ["weak", "directional", "quantitative"]},
    "independence_group_refs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
    "content_hash": {"$ref": "#/$defs/hash"},
    "status": {"enum": ["admitted", "weak_directional_only", "blocked", "rejected"]}
  },
  "allOf": [
    {
      "if": {"properties": {"target_type": {"const": "numeric_endpoint"}}},
      "then": {
        "properties": {
          "label_value": {"type": "number"},
          "unit": {"type": "string", "minLength": 1}
        }
      }
    },
    {
      "if": {"properties": {"target_type": {"const": "directional_endpoint"}}},
      "then": {"properties": {"label_value": {"$ref": "#/$defs/direction_label"}}}
    }
  ],
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "target_type": {
      "enum": ["directional_endpoint", "numeric_endpoint", "candidate_ranking", "mechanism_status", "information_action_value", "hypothesis_status"]
    },
    "direction_label": {
      "enum": ["increase", "decrease", "no_clear_effect", "mixed_or_context_dependent", "insufficient_information"]
    },
    "label_value": {
      "oneOf": [
        {"$ref": "#/$defs/direction_label"},
        {"type": "number"},
        {"enum": ["supported", "refuted", "unresolved"]},
        {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}}
      ]
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "value", "unknown_components"],
      "properties": {
        "status": {"enum": ["quantified", "unknown", "not_applicable"]},
        "value": {"type": ["number", "null"], "minimum": 0},
        "unknown_components": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
        "method": {"type": ["string", "null"]}
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "unknown"}}},
          "then": {
            "properties": {
              "value": {"type": "null"},
              "unknown_components": {"minItems": 1}
            }
          }
        },
        {
          "if": {"properties": {"status": {"const": "quantified"}}},
          "then": {
            "properties": {
              "value": {"type": "number", "minimum": 0},
              "unknown_components": {"maxItems": 0}
            }
          }
        }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_uid", "publication_or_accession_identity", "content_hash", "public_availability_timestamp"],
      "properties": {
        "source_uid": {"$ref": "#/$defs/text"},
        "publication_or_accession_identity": {"$ref": "#/$defs/text"},
        "content_hash": {"$ref": "#/$defs/hash"},
        "public_availability_timestamp": {"type": "string", "format": "date-time"}
      }
    }
  }
}
