{
  "$defs": {
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    }
  },
  "$id": "https://neuronsifter.local/schema/c1_rescue_vocabulary_manifest.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action_category_values": {
      "const": {
        "dose_unit": [
          "mg",
          "um"
        ],
        "route": [
          "in_vitro_media",
          "intraperitoneal",
          "not_applicable_in_vitro"
        ],
        "schedule": [
          "continuous_72h",
          "explicit_unavailable",
          "three_times_per_week"
        ]
      }
    },
    "action_descriptor_record_count": {
      "const": 7124
    },
    "action_descriptor_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "action_descriptor_version": {
      "const": "neuronsifter-c1-physical-exposure-descriptor-v2"
    },
    "action_feature_dim": {
      "const": 10
    },
    "action_feature_names": {
      "const": [
        "log1p_dose_value",
        "log1p_duration_hours",
        "dose_unit=mg",
        "dose_unit=um",
        "schedule=continuous_72h",
        "schedule=explicit_unavailable",
        "schedule=three_times_per_week",
        "route=in_vitro_media",
        "route=intraperitoneal",
        "route=not_applicable_in_vitro"
      ]
    },
    "action_feature_schema_version": {
      "const": "neuronsifter-c1-action-vector-v2"
    },
    "action_identity_scope": {
      "const": "physical_exposure_only_without_agent_target_or_occupancy_identity"
    },
    "action_target_set_available_count": {
      "const": 0
    },
    "block_feature_hashes": {
      "additionalProperties": {
        "$ref": "#/$defs/sha256"
      },
      "minProperties": 6,
      "type": "object"
    },
    "cell_context_policy": {
      "const": "source_vocabulary_context_ids_not_graph_ontology_embeddings"
    },
    "cell_mapping_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "cell_ontology_count": {
      "minimum": 0,
      "type": "integer"
    },
    "cell_ontology_size": {
      "minimum": 1,
      "type": "integer"
    },
    "corpus_hash": {
      "const": "3c9899d1704ce262801229d98fb5402f49159fb8959295d3b86600522b4ab7f1"
    },
    "corpus_uid": {
      "const": "public_foundation_corpus_rescue"
    },
    "crosswalk": {
      "additionalProperties": false,
      "properties": {
        "mapping_version": {
          "minLength": 1,
          "type": "string"
        },
        "path": {
          "minLength": 1,
          "type": "string"
        },
        "record_count": {
          "const": 8
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "mapping_version",
        "path",
        "sha256",
        "record_count"
      ],
      "type": "object"
    },
    "crosswalk_usage": {
      "const": "provenance_binding_and_identity_audit_only"
    },
    "derivation_policy": {
      "const": "read_only_derived_artifact_for_frozen_rescue"
    },
    "family_class_count": {
      "const": 3
    },
    "family_mapping_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "feature_count": {
      "minimum": 1,
      "type": "integer"
    },
    "feature_mapping_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "feature_namespace_aliases": {
      "additionalProperties": {
        "type": "string"
      },
      "type": "object"
    },
    "feature_namespace_counts": {
      "additionalProperties": {
        "minimum": 1,
        "type": "integer"
      },
      "type": "object"
    },
    "feature_normalization_version": {
      "const": "neuronsifter-c1-feature-token-v1"
    },
    "feature_tokenization_policy": {
      "const": "namespace_preserving_gene_token_union_no_cross_namespace_merge"
    },
    "feature_value_normalization_version": {
      "const": "neuronsifter-c1-observation-zscore-leave-one-masked-out-v2"
    },
    "feature_vocabulary_size": {
      "minimum": 2,
      "type": "integer"
    },
    "observation_binding_hash": {
      "$ref": "#/$defs/sha256"
    },
    "program_vocab_status": {
      "const": "not_available"
    },
    "region_context_policy": {
      "const": "source_vocabulary_context_ids_not_graph_ontology_embeddings"
    },
    "region_mapping_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "region_ontology_count": {
      "minimum": 0,
      "type": "integer"
    },
    "region_ontology_size": {
      "minimum": 1,
      "type": "integer"
    },
    "schema_version": {
      "const": "neuronsifter-c1-vocabulary-manifest-v1"
    },
    "scope": {
      "const": "reduced_transcriptomics_core_v2_rescue"
    },
    "source_class_count": {
      "minimum": 2,
      "type": "integer"
    },
    "source_mapping_sha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "required": [
    "schema_version",
    "corpus_uid",
    "corpus_hash",
    "scope",
    "derivation_policy",
    "feature_normalization_version",
    "feature_value_normalization_version",
    "feature_tokenization_policy",
    "crosswalk_usage",
    "feature_namespace_aliases",
    "feature_count",
    "feature_vocabulary_size",
    "feature_mapping_sha256",
    "feature_namespace_counts",
    "crosswalk",
    "cell_ontology_count",
    "cell_ontology_size",
    "cell_context_policy",
    "cell_mapping_sha256",
    "region_ontology_count",
    "region_ontology_size",
    "region_context_policy",
    "region_mapping_sha256",
    "source_class_count",
    "source_mapping_sha256",
    "family_class_count",
    "family_mapping_sha256",
    "action_feature_schema_version",
    "action_descriptor_version",
    "action_feature_dim",
    "action_feature_names",
    "action_category_values",
    "action_descriptor_sha256",
    "action_descriptor_record_count",
    "action_identity_scope",
    "action_target_set_available_count",
    "program_vocab_status",
    "observation_binding_hash",
    "block_feature_hashes"
  ],
  "title": "NeuronSifter C1 vocabulary manifest V2 rescue",
  "type": "object"
}
