{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://neuronsifter.org/schemas/rollout_engine.schema.json",
  "title": "NeuronSifter RolloutEngine", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "engine_uid", "engine_type", "version", "source", "code_identity", "environment_identity", "supported_baseline_classes", "supported_action_classes", "supported_state_variables", "supported_horizons", "supported_fidelities", "support_domain_ref", "uncertainty_capabilities", "constraint_capabilities", "qualification_evidence", "known_limitations", "trained", "status"],
  "properties": {
    "schema_version": {"const": "neuronsifter-rollout-engine-v1"}, "engine_uid": {"$ref": "#/$defs/text"},
    "engine_type": {"enum": ["mechanistic_rollout_engine", "qualified_simulator", "validated_replay_engine", "hybrid_multiscale_rollout", "learned_world_action_model", "ensemble_rollout_engine"]},
    "version": {"$ref": "#/$defs/text"}, "source": {"$ref": "#/$defs/text"}, "code_identity": {"$ref": "#/$defs/hash"}, "environment_identity": {"$ref": "#/$defs/hash"},
    "supported_baseline_classes": {"$ref": "#/$defs/texts"}, "supported_action_classes": {"$ref": "#/$defs/texts"}, "supported_state_variables": {"$ref": "#/$defs/texts"},
    "supported_horizons": {"type": "array", "minItems": 1, "items": {"type": "object", "minProperties": 3}}, "supported_fidelities": {"$ref": "#/$defs/texts"},
    "support_domain_ref": {"$ref": "#/$defs/text"}, "uncertainty_capabilities": {"$ref": "#/$defs/texts"}, "constraint_capabilities": {"$ref": "#/$defs/texts"},
    "qualification_evidence": {"type": "object", "minProperties": 1}, "known_limitations": {"$ref": "#/$defs/texts"}, "trained": {"type": "boolean"},
    "status": {"enum": ["qualified_for_contract_testing", "qualified_for_restricted_what_if", "qualified_for_formal_what_if", "stress_only", "unsupported", "blocked_untrained", "blocked_support_domain", "blocked_action", "blocked_state_namespace", "blocked_reliability"]}
  },
  "$defs": {"text": {"type": "string", "minLength": 1}, "texts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}}, "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
