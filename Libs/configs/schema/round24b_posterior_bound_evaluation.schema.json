    "outputs": {"type": "object", "required": ["c1_binding_audit", "c2s_binding_audit", "c1_pre_post_metrics", "c2s_pre_post_metrics", "update_strategy_results", "paired_metrics", "bootstrap_summary", "posterior_lineage_catalog", "twin_gate"]}
