{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neuronsifter.local/schemas/prospective-twin-training-authorization-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "development_domain_qualified",
    "method_preregistered",
    "training_authorized",
    "gpu_authorized",
    "audit_uid",
    "reviewed_on",
    "allowed_scope",
    "blocked_scope",
    "terminal_blocker",
    "six_context_outcome_access",
    "protected_holdout_access",
    "decision_binding"
  ],
  "properties": {
    "schema_version": {"const": "neuronsifter-prospective-twin-training-authorization-v1"},
    "status": {"enum": ["issuable_pending_gpu_authorization", "not_issuable"]},
    "development_domain_qualified": {"type": "boolean"},
    "method_preregistered": {"type": "boolean"},
    "training_authorized": {"const": false},
    "gpu_authorized": {"const": false},
    "audit_uid": {"type": "string", "minLength": 1},
    "reviewed_on": {"type": "string", "format": "date"},
    "allowed_scope": {"type": "array", "items": {"type": "string"}},
    "blocked_scope": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "terminal_blocker": {"type": ["string", "null"]},
    "six_context_outcome_access": {"const": 0},
    "protected_holdout_access": {"const": 0},
    "decision_binding": {"type": "object"}
  }
}
