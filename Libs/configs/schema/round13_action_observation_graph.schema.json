{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neuronsifter.org/schemas/round13_action_observation_graph.schema.json",
  "title": "NeuronSifter Round-13 action observation graph",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "graph_uid", "contract_scope", "source_handoff", "support_domains", "conflicts", "world_actions", "information_actions", "observation_requests", "tool_requests", "tool_capability_matches", "tool_availability_decisions", "raw_tool_results", "observation_qc", "canonical_observations", "exposure_occupancy_programs", "canonical_action_fields", "action_support_decisions", "assimilation_proposals", "assimilation_decisions", "hypothetical_scenarios", "lineage_edges", "frozen_gap_map", "invariants", "evidence_fabric", "dt_core"],
  "properties": {
    "schema_version": {"const": "neuronsifter-round13-action-observation-graph-v1"},
    "graph_uid": {"type": "string", "minLength": 1},
    "contract_scope": {"const": "round13_contract_validation_pilot_only"},
    "source_handoff": {"type": "object", "required": ["canonical_uri", "sha256", "parent_gate"], "properties": {"canonical_uri": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "parent_gate": {"const": "typed_evidence_relationships_resolved"}}, "additionalProperties": false},
    "support_domains": {"type": "array", "items": {"type": "object"}, "minItems": 1},
    "conflicts": {"type": "array", "items": {"type": "object"}},
    "world_actions": {"type": "array", "items": {"type": "object"}, "minItems": 3},
    "information_actions": {"type": "array", "items": {"type": "object"}, "minItems": 1},
    "observation_requests": {"type": "array", "items": {"type": "object"}, "minItems": 1},
    "tool_requests": {"type": "array", "items": {"type": "object"}, "minItems": 2},
    "tool_capability_matches": {"type": "array", "items": {"type": "object"}, "minItems": 2},
    "tool_availability_decisions": {"type": "array", "items": {"type": "object"}, "minItems": 2},
    "raw_tool_results": {"type": "array", "items": {"type": "object"}, "minItems": 3},
    "observation_qc": {"type": "array", "items": {"type": "object"}, "minItems": 3},
    "canonical_observations": {"type": "array", "items": {"type": "object"}, "minItems": 2},
    "exposure_occupancy_programs": {"type": "array", "items": {"type": "object"}, "minItems": 1},
    "canonical_action_fields": {"type": "array", "items": {"type": "object"}, "minItems": 2},
    "action_support_decisions": {"type": "array", "items": {"type": "object"}, "minItems": 2},
    "assimilation_proposals": {"type": "array", "items": {"type": "object"}, "minItems": 3},
    "assimilation_decisions": {"type": "array", "items": {"type": "object"}, "minItems": 3},
    "hypothetical_scenarios": {"type": "array", "items": {"type": "object"}, "minItems": 1},
    "lineage_edges": {"type": "array", "items": {"type": "object", "required": ["source_uid", "target_uid", "relation_type"], "additionalProperties": false, "properties": {"source_uid": {"type": "string"}, "target_uid": {"type": "string"}, "relation_type": {"type": "string"}}}},
    "frozen_gap_map": {"type": "array", "items": {"type": "object"}, "minItems": 20, "maxItems": 20},
    "invariants": {"type": "object"},
    "evidence_fabric": {"type": "object", "required": ["sealed"], "properties": {"sealed": {"const": false}}, "additionalProperties": false},
    "dt_core": {"type": "object", "required": ["status"], "properties": {"status": {"const": "not_evaluated"}}, "additionalProperties": false}
  }
}
