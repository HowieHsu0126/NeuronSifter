{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neuronsifter.local/schemas/round11g_execution_input_bundle.schema.json",
  "title": "NeuronSifter Round-11G Execution Input Bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bundle_uid",
    "schema_version",
    "code_commit",
    "config_hash",
    "processed_input_entries",
    "external_asset_entries",
    "environment_entries",
    "producer_lineage",
    "license_or_access_decisions",
    "content_hashes",
    "canonical_locations",
    "materialization_commands",
    "read_only_policy",
    "missing_entries",
    "validation_status",
    "environment_hash"
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_uid",
        "logical_role",
        "artifact_type",
        "source_uid",
        "producer_uid",
        "version",
        "content_hash",
        "size",
        "canonical_uri",
        "license_or_access_status",
        "required_by_testcases",
        "allowed_execution_role"
      ],
      "properties": {
        "asset_uid": {"type": "string", "minLength": 1},
        "logical_role": {"type": "string", "minLength": 1},
        "artifact_type": {"type": "string", "minLength": 1},
        "source_uid": {"type": "string", "minLength": 1},
        "producer_uid": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "content_hash": {"$ref": "#/$defs/sha256"},
        "size": {"type": "integer", "minimum": 0},
        "canonical_uri": {"type": "string", "pattern": "^repo://(Input/processed|Output)/"},
        "license_or_access_status": {
          "enum": [
            "approved_internal_read_only",
            "approved_public_source_derived_internal_read_only"
          ]
        },
        "required_by_testcases": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "allowed_execution_role": {
          "enum": ["processed_test_input", "read_only_parent_audit"]
        }
      }
    }
  },
  "properties": {
    "bundle_uid": {"type": "string", "minLength": 1},
    "schema_version": {"const": "dt-round11g-execution-input-bundle-v1"},
    "code_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "config_hash": {"$ref": "#/$defs/sha256"},
    "processed_input_entries": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/asset"}},
    "external_asset_entries": {"type": "array", "items": {"$ref": "#/$defs/asset"}},
    "environment_entries": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "producer_lineage": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "license_or_access_decisions": {"type": "array", "minItems": 1, "items": {"type": "object"}},
    "content_hashes": {"type": "object", "additionalProperties": {"$ref": "#/$defs/sha256"}},
    "canonical_locations": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^repo://"}},
    "materialization_commands": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "read_only_policy": {"type": "object"},
    "missing_entries": {"type": "array", "maxItems": 0},
    "validation_status": {"const": "passed"},
    "environment_hash": {"$ref": "#/$defs/sha256"}
  }
}
