{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neuronsifter.org/schemas/trajectory_producer.schema.json",
  "title": "NeuronSifter TrajectoryProducer",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "producer_uid", "version", "producer_type", "source", "source_hash", "license_or_access_status", "equation_or_model_identity", "input_schema", "output_schema", "supported_action_classes", "supported_state_variables", "support_domain_ref", "parameter_policy", "seed_policy", "numerical_solver_policy", "known_limitations", "status"],
  "properties": {
    "schema_version": {"const": "neuronsifter-trajectory-producer-v1"},
    "producer_uid": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "producer_type": {"enum": ["mechanistic_ode", "mechanistic_pde", "agent_based_model", "network_dynamics_model", "hybrid_multiscale_simulator", "governed_scientific_tool", "validated_replay_engine"]},
    "source": {"type": "string", "minLength": 1},
    "source_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "license_or_access_status": {"enum": ["verified_public", "repository_internal_governed", "resolved_restricted"]},
    "equation_or_model_identity": {"type": "string", "minLength": 1},
    "input_schema": {"type": "string", "minLength": 1},
    "output_schema": {"const": "neuronsifter-clean-action-complete-trajectory-v1"},
    "supported_action_classes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["pharmacological", "genetic", "electrical_stimulation", "optical_stimulation", "environmental", "state_initialization", "no_action_control", "combination"]}},
    "supported_state_variables": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "support_domain_ref": {"type": "string", "minLength": 1},
    "parameter_policy": {"type": "object", "minProperties": 1},
    "seed_policy": {"type": "object", "minProperties": 1},
    "numerical_solver_policy": {"type": "object", "minProperties": 1},
    "known_limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "status": {"enum": ["registered", "blocked", "retired"]}
  }
}
