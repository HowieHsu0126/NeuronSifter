{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neuronsifter.org/schemas/scientific_hypothesis.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "hypothesis_uid", "mechanism_statement", "target_variables", "expected_outcome", "required_context", "time_horizon", "potential_falsifier", "supporting_evidence", "conflicting_evidence", "support_domain_ref", "uncertainty", "causal_effect_claim", "clinical_efficacy_claim", "hypothetical_as_empirical_support"],
  "properties": {
    "schema_version": {"const": "neuronsifter-scientific-hypothesis-v1"},
    "hypothesis_uid": {"$ref": "#/$defs/text"},
    "mechanism_statement": {"$ref": "#/$defs/text"},
    "target_variables": {"$ref": "#/$defs/nonempty_texts"},
    "expected_outcome": {"type": "object", "minProperties": 1},
    "required_context": {"type": "object", "minProperties": 1},
    "time_horizon": {"type": "object", "minProperties": 1},
    "potential_falsifier": {"type": "object", "minProperties": 1},
    "supporting_evidence": {"$ref": "#/$defs/texts"},
    "conflicting_evidence": {"$ref": "#/$defs/texts"},
    "support_domain_ref": {"$ref": "#/$defs/text"},
    "uncertainty": {"type": "object", "minProperties": 1},
    "causal_effect_claim": {"const": false},
    "clinical_efficacy_claim": {"const": false},
    "hypothetical_as_empirical_support": {"const": false}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "texts": {"type": "array", "items": {"$ref": "#/$defs/text"}, "uniqueItems": true},
    "nonempty_texts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}, "uniqueItems": true}
  }
}
