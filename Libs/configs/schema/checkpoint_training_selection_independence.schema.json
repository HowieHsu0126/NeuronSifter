{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neuronsifter.local/schemas/checkpoint-training-selection-independence-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "review_uid",
    "reviewed_on",
    "evaluation_identity_source",
    "bounded_exact_overlap_check",
    "semantic_overlap_assessment",
    "candidate_findings",
    "formal_independence_proven",
    "six_context_outcome_access",
    "protected_holdout_access",
    "artifact_bindings"
  ],
  "properties": {
    "schema_version": {"const": "neuronsifter-checkpoint-training-selection-independence-v1"},
    "status": {"enum": ["formal_independence_proven", "formal_independence_not_proven"]},
    "review_uid": {"type": "string", "minLength": 1},
    "reviewed_on": {"type": "string", "format": "date"},
    "evaluation_identity_source": {"type": "object"},
    "bounded_exact_overlap_check": {"type": "object"},
    "semantic_overlap_assessment": {"type": "object"},
    "candidate_findings": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "object"}},
    "formal_independence_proven": {"type": "boolean"},
    "six_context_outcome_access": {"const": 0},
    "protected_holdout_access": {"const": 0},
    "artifact_bindings": {"type": "object"}
  }
}
