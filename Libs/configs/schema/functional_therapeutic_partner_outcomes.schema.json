{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neuronsifter.local/schemas/functional-therapeutic-partner-outcomes-v1.json",
  "title": "NeuronSifter functional therapeutic partner outcome row",
  "type": "object",
  "required": ["study_uid", "context_uid", "replicate_uid", "control_or_treatment", "agent", "objective_uid", "endpoint_name", "value", "unit", "timepoint", "source_url"],
  "properties": {
    "study_uid": {"type": "string", "minLength": 1},
    "context_uid": {"type": "string", "minLength": 1},
    "replicate_uid": {"type": "string", "minLength": 1},
    "control_or_treatment": {"enum": ["control", "treatment"]},
    "agent": {"type": "string", "minLength": 1},
    "dose": {"type": ["number", "null"]},
    "dose_unit": {"type": ["string", "null"]},
    "schedule": {"type": ["string", "null"]},
    "duration": {"type": ["number", "null"]},
    "duration_unit": {"type": ["string", "null"]},
    "objective_uid": {"enum": ["functional_electrophysiology_rescue_v1", "functional_calcium_activity_rescue_v1", "functional_cell_viability_rescue_v1", "functional_neurite_morphology_rescue_v1", "functional_synaptic_phenotype_rescue_v1", "functional_pathology_phenotype_rescue_v1"]},
    "endpoint_name": {"type": "string", "minLength": 1},
    "value": {"type": "number"},
    "unit": {"type": "string", "minLength": 1},
    "timepoint": {"type": "string", "minLength": 1},
    "time_unit": {"type": ["string", "null"]},
    "batch": {"type": ["string", "null"]},
    "uncertainty_type": {"enum": ["sd", "sem", "ci", null]},
    "uncertainty_value": {"type": ["number", "null"]},
    "ci_lower": {"type": ["number", "null"]},
    "ci_upper": {"type": ["number", "null"]},
    "source_url": {"type": "string", "format": "uri"},
    "source_file": {"type": ["string", "null"]},
    "provenance_note": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
