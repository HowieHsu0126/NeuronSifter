{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neuronsifter.local/schemas/therapeutic-evidence-expansion-v2.json",
  "title": "NeuronSifter therapeutic evidence expansion audit",
  "type": "object",
  "required": [
    "schema_version",
    "created_at",
    "status",
    "selected_sources",
    "source_count",
    "observation_count",
    "action_count",
    "structural_candidate_set_count",
    "candidate_set_count",
    "qualified_candidate_set_count",
    "objective_namespace_status",
    "outcome_values_inspected_for_source_selection",
    "model_predictions_inspected",
    "evidence_role",
    "publication_claim_eligible",
    "protected_holdout_access",
    "input_bindings",
    "source_summaries",
    "output_bindings",
    "implementation_binding",
    "schema_binding",
    "config_binding"
  ],
  "properties": {
    "schema_version": {"const": "neuronsifter-therapeutic-evidence-materialization-v2"},
    "created_at": {"type": "string", "minLength": 1},
    "status": {"const": "materialized_structure_blocked_objective_namespace"},
    "selected_sources": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "source_count": {"type": "integer", "minimum": 1},
    "observation_count": {"type": "integer", "minimum": 1},
    "action_count": {"type": "integer", "minimum": 1},
    "structural_candidate_set_count": {"type": "integer", "minimum": 0},
    "candidate_set_count": {"const": 0},
    "qualified_candidate_set_count": {"const": 0},
    "objective_namespace_status": {"const": "blocked_platform_annotation_missing"},
    "outcome_values_inspected_for_source_selection": {"const": false},
    "model_predictions_inspected": {"const": false},
    "evidence_role": {"const": "development_only"},
    "publication_claim_eligible": {"const": false},
    "protected_holdout_access": {"const": 0},
    "input_bindings": {"type": "object", "required": ["source_priority_audit", "source_priority_table"]},
    "source_summaries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "source_accession",
          "input_bindings",
          "platform_annotation_path",
          "platform_annotation_available",
          "sdrf_row_count",
          "observation_count",
          "action_count",
          "actions",
          "replicate_counts",
          "matched_control_present",
          "control_evidence_mode",
          "objective_namespace_status",
          "candidate_set_count",
          "qualified_candidate_set_count",
          "structural_candidate_set_count"
        ],
        "properties": {
          "source_accession": {"type": "string", "minLength": 1},
          "input_bindings": {"type": "object", "required": ["sdrf", "processed_archive"]},
          "platform_annotation_path": {"type": "string", "minLength": 1},
          "platform_annotation_available": {"const": false},
          "sdrf_row_count": {"type": "integer", "minimum": 1},
          "observation_count": {"type": "integer", "minimum": 1},
          "action_count": {"type": "integer", "minimum": 1},
          "actions": {"type": "array", "items": {"type": "string"}},
          "replicate_counts": {"type": "object"},
          "matched_control_present": {"type": "boolean"},
          "control_evidence_mode": {"enum": ["paired_two_colour_control", "explicit_control_observation"]},
          "objective_namespace_status": {"const": "blocked_platform_annotation_missing"},
          "candidate_set_count": {"const": 0},
          "qualified_candidate_set_count": {"const": 0},
          "structural_candidate_set_count": {"type": "integer", "minimum": 0}
        },
        "additionalProperties": true
      }
    },
    "output_bindings": {"type": "object"},
    "implementation_binding": {"type": "object", "required": ["path", "bytes", "sha256"]},
    "schema_binding": {"type": "object", "required": ["path", "bytes", "sha256"]},
    "config_binding": {"type": "object", "required": ["path", "bytes", "sha256"]}
  },
  "additionalProperties": true
}
