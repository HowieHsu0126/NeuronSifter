    "typed_current_clamp": {"type": "object", "required": ["schema_version", "route", "target", "amplitude_unit", "duration_unit", "delay_unit", "response_species_ids", "posterior_condition_channel_species", "signed_species_ids"], "properties": {"response_species_ids": {"type": "array", "items": {"type": "string"}, "minItems": 1}, "posterior_condition_channel_species": {"type": "object", "additionalProperties": false, "required": ["posterior_response_mean", "posterior_response_std"], "properties": {"posterior_response_mean": {"type": "string", "minLength": 1}, "posterior_response_std": {"type": "string", "minLength": 1}}}, "signed_species_ids": {"type": "array", "items": {"type": "string"}}}},
    "prospective": {"type": "object", "required": ["rounds", "query_without_replacement", "common_frozen_agent", "candidate_pool_uid", "candidate_pool_visibility", "candidate_protocols"], "properties": {"candidate_protocols": {"type": "array", "minItems": 3, "items": {"type": "object", "required": ["action_uid", "pair_uid", "amplitude_nA", "duration_ms", "delay_ms"]}}}},
    "updates": {"type": "object", "required": ["strategies", "neural_checkpoint_update_allowed", "agent_parameters_update_allowed", "minimum_old_domain_retention", "maximum_calibration_drift", "coverage_floor", "minimum_new_evidence_fit_gain"]},
    "bad_update": {"type": "object", "additionalProperties": false, "required": ["maximum_posterior_mean_l2_shift", "metrics_restore_tolerance"], "properties": {"maximum_posterior_mean_l2_shift": {"type": "number", "exclusiveMinimum": 0}, "metrics_restore_tolerance": {"const": 0.0}}},
