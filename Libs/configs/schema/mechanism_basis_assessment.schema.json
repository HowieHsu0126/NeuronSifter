{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://neuronsifter.local/schema/mechanism_basis_assessment.schema.json",
  "title": "NeuronSifter mechanism-basis coverage assessment",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "assessment_uid", "contract", "schema", "authorization", "evidence_ledger", "source_claim_graph", "requirements", "coverage_counts", "canonical_prior_support", "sensitivity_prior_support", "uncovered_required_requirement_uids", "contradictory_required_requirement_uids", "decision_candidate", "access_counters", "downstream_authorization", "assessment_sha256", "blockers"],
  "properties": {
    "schema_version": {"const": "neuronsifter-mechanism-basis-assessment-v1"},
    "status": {"const": "MECHANISM_BASIS_ASSESSED"},
    "assessment_uid": {"const": "mechanism_basis_assessment"},
    "contract": {"$ref": "#/$defs/fileBinding"},
    "schema": {"$ref": "#/$defs/fileBinding"},
    "authorization": {"$ref": "#/$defs/artifactBinding"},
    "evidence_ledger": {"$ref": "#/$defs/artifactBinding"},
    "source_claim_graph": {"$ref": "#/$defs/artifactBinding"},
    "requirements": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/coverage"}},
    "coverage_counts": {"type": "object", "additionalProperties": false, "required": ["requirement_count", "required_count", "covered_required_count", "uncovered_required_count", "contradictory_required_count"], "properties": {"requirement_count": {"type": "integer", "minimum": 1}, "required_count": {"type": "integer", "minimum": 1}, "covered_required_count": {"type": "integer", "minimum": 0}, "uncovered_required_count": {"type": "integer", "minimum": 0}, "contradictory_required_count": {"type": "integer", "minimum": 0}}},
    "canonical_prior_support": {"$ref": "#/$defs/priorSupport"},
    "sensitivity_prior_support": {"type": "array", "items": {"$ref": "#/$defs/priorSupport"}},
    "uncovered_required_requirement_uids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "contradictory_required_requirement_uids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "decision_candidate": {"enum": ["MECHANISM_BASIS_QUALIFIED", "MECHANISM_BASIS_INSUFFICIENT"]},
    "access_counters": {"$ref": "#/$defs/accessCounters"},
    "downstream_authorization": {"type": "object"},
    "assessment_sha256": {"$ref": "#/$defs/sha256"},
    "blockers": {"type": "array", "maxItems": 0}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "fileBinding": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string"}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "artifactBinding": {"type": "object", "additionalProperties": false, "required": ["path", "file_sha256", "semantic_sha256"], "properties": {"path": {"type": "string"}, "file_sha256": {"$ref": "#/$defs/sha256"}, "semantic_sha256": {"$ref": "#/$defs/sha256"}}},
    "priorSupport": {"type": "object", "additionalProperties": false, "required": ["role_uid", "required", "support_status"], "properties": {"role_uid": {"type": "string"}, "required": {"type": "boolean"}, "support_status": {"enum": ["supported", "unsupported", "contradictory"]}}},
    "coverage": {"type": "object", "additionalProperties": false, "required": ["requirement_uid", "required", "coverage_status", "admitted_claim_uids", "source_slot_uids", "contradiction_uids", "absence_reason"], "properties": {"requirement_uid": {"type": "string"}, "required": {"type": "boolean"}, "coverage_status": {"enum": ["covered", "uncovered", "contradictory"]}, "admitted_claim_uids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "source_slot_uids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "contradiction_uids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "absence_reason": {"type": ["string", "null"]}}},
    "accessCounters": {"type": "object", "additionalProperties": false, "required": ["source_content_access", "successful_source_content_opens", "unqueued_source_attempts", "forbidden_value_reads", "six_context_outcome_access", "protected_holdout_access"], "properties": {"source_content_access": {"type": "integer", "minimum": 0, "maximum": 15}, "successful_source_content_opens": {"type": "integer", "minimum": 0, "maximum": 15}, "unqueued_source_attempts": {"const": 0}, "forbidden_value_reads": {"const": 0}, "six_context_outcome_access": {"const": 0}, "protected_holdout_access": {"const": 0}}}
  }
}
